# =====================================================================
# Production Client Environment Configuration Template
# =====================================================================
# NOTE: In Vite, only variables prefixed with 'VITE_' are bundled into the client!
# NEVER put private API secrets, database passwords, or auth keys in this file.

# Option 1: Unified Reverse Proxy Deployment (Caddy / Nginx / Single VPS)
# When your frontend and backend are served under the same domain (e.g. https://party.yourdomain.com),
# leave VITE_API_URL blank. The browser will use relative '/api' paths automatically.
# VITE_API_URL=

# Option 2: Separately Hosted Deployment (e.g. Vercel / Cloudflare Pages frontend + Render/VPS backend)
# Set VITE_API_URL to the public HTTPS URL of your deployed Express backend API (no trailing slash).
# Example: VITE_API_URL=https://api.yourdomain.com
VITE_API_URL=https://api.yourdomain.com
