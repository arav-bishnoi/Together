# =====================================================================
# Production Server Environment Configuration Template
# =====================================================================
# Copy this file to .env on your production server:
#   cp .env.production.example .env
#
# IMPORTANT SECURITY RULES:
# 1. Never commit your real .env file to Git.
# 2. Never use 'devkey' or 'secret' in production (the server will refuse to start).
# 3. Generate strong random keys using: openssl rand -hex 24
# =====================================================================

NODE_ENV=production
PORT=3001

# ---------------------------------------------------------------------
# LiveKit Media Server Configuration
# ---------------------------------------------------------------------
# For Self-Hosted LiveKit (e.g. running in Docker or on your VPS):
# Internal URL used by the Node.js backend to mint tokens (usually localhost or Docker container name):
LIVEKIT_URL=http://127.0.0.1:7880

# Public WSS URL accessed by browsers (must be https / wss with TLS):
# Example: wss://livekit.yourdomain.com
PUBLIC_LIVEKIT_URL=wss://livekit.yourdomain.com

# For Managed LiveKit Cloud (Free tier):
# LIVEKIT_URL=https://your-project.livekit.cloud
# PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# LiveKit API Key and Secret (Generate unique values: openssl rand -hex 16)
LIVEKIT_API_KEY=replace_with_strong_random_key_e39f7a
LIVEKIT_API_SECRET=replace_with_strong_random_secret_9c82b1

# ---------------------------------------------------------------------
# Client Origin / CORS Allowlist
# ---------------------------------------------------------------------
# Set to your production frontend domain (no trailing slash).
# If you have multiple domains, separate them with commas.
# Example: https://party.yourdomain.com
CLIENT_ORIGIN=https://party.yourdomain.com

# ---------------------------------------------------------------------
# NAT / Firewall Traversal: STUN & TURN Relay
# ---------------------------------------------------------------------
# In real-world networks where the guest is on an Android phone using 4G/5G
# mobile data (Carrier-Grade NAT), peer-to-peer UDP is blocked.
# A TURN relay is REQUIRED for audio/video to connect across different networks.
#
# Self-Hosted Coturn configuration:
# Format: turn:<domain_or_ip>:3478?transport=udp
TURN_URL=turn:turn.yourdomain.com:3478?transport=udp
TURN_USERNAME=watchparty_guest
TURN_CREDENTIAL=replace_with_strong_turn_password

# ---------------------------------------------------------------------
# Security & Token Lifecycle Policies
# ---------------------------------------------------------------------
# Short-lived media tokens (in seconds). Default: 1800 (30 minutes).
TOKEN_TTL_SECONDS=1800

# Room expiration window (in hours). Default: 12 hours.
ROOM_EXPIRY_HOURS=12
